generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum AdminMenuPermission {
  NOTICES
  PRIESTS
  NUNS
  BULLETINS
  EVENTS
  GALLERY
  COMMUNITY_ABOUT
  PASTORAL_COUNCIL
  YOUTH_ABOUT
  YOUTH_BLOG
  INQUIRIES
}

enum PostCategory {
  NOTICE
  BULLETIN
  GALLERY
  LEGACY_BOARD
  YOUTH_BLOG
  COMMUNITY_INTRO
  YOUTH_INTRO
}

enum ClergyType {
  PRIEST
  NUN
}

enum PastoralCouncilPlaceholderImageType {
  WOMAN
  MAN
  NUN
  PRIEST
}

enum InquiryStatus {
  RECEIVED // 접수됨(아직 답변/처리 전)
  IN_PROGRESS // 담당자 확인/처리 중
  DONE // 처리 완료
}

enum InquiryType {
  MASS_SACRAMENT // 미사 및 성사 문의
  CATECHUMEN_CLASS // 예비신자/교리 문의
  FAITH_PARISH_LIFE // 신앙 및 본당 생활 문의
  FACILITY_RENTAL // 시설 및 대관 문의
  WEBSITE_ONLINE // 홈페이지/온라인 서비스 문의
  VOLUNTEER_DONATION // 봉사 및 후원 문의
  OTHER // 기타 문의
}

enum PostAssetRole {
  CONTENT
  COVER
  ATTACHMENT
}

model User {
  id              String                @id @default(cuid()) // 고유 식별자
  username        String                @unique // 관리자 로그인 아이디(소문자로 정규화, 중복 불가)
  passwordHash    String // 해시된 비밀번호
  displayName     String // 관리자 표시 이름
  role            UserRole              @default(EDITOR) // 관리자 권한 역할
  menuPermissions AdminMenuPermission[] @default([]) // 일반 관리자가 접근할 수 있는 메뉴 식별자 목록
  isActive        Boolean               @default(true) // 활성/비활성 상태
  createdAt       DateTime              @default(now()) // 생성 시각
  updatedAt       DateTime              @updatedAt // 수정 시각

  posts              Post[] // 작성한 게시글 목록
  events             Event[] // 작성한 일정 목록
  processedInquiries Inquiry[]           @relation("InquiryProcessedBy") // 처리한 문의 목록
  fileAssets         FileAsset[] // 업로드한 물리 파일 자산 목록
  refreshTokens      AdminRefreshToken[] // 관리자 로그인 갱신 토큰 목록
}

model AdminRefreshToken {
  id            String    @id @default(cuid()) // 갱신 토큰 레코드 식별자
  userId        String // 토큰 소유 관리자 식별자
  familyId      String // 회전 과정에서 토큰 재사용을 추적하는 세션 계열 식별자
  tokenHash     String    @unique // 원문 대신 저장하는 SHA-256 토큰 해시
  rotatedToHash String? // 회전 후 발급된 다음 토큰의 해시
  expiresAt     DateTime // 토큰 만료 시각
  usedAt        DateTime? // 회전 처리된 시각이며 null이면 아직 사용 가능
  revokedAt     DateTime? // 로그아웃·재사용 탐지로 폐기된 시각
  createdAt     DateTime  @default(now()) // 토큰 발급 시각

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Post {
  id              String       @id @default(cuid()) // 고유 식별자
  category        PostCategory // 게시글 카테고리
  title           String // 제목
  slug            String       @unique // URL 식별자(중복 불가)
  summary         String? // 요약문
  content         String       @db.Text // 본문 내용
  youtubeUrl      String? // 본문에서 추출한 최초 YouTube 링크
  isPublished     Boolean      @default(false) // 공개 여부
  publishedAt     DateTime? // 공개 시각
  isPinned        Boolean      @default(false) // 상단 고정 여부
  sortOrder       Int          @default(0) // 노출 정렬 순서
  viewCount       Int          @default(0) // 조회수
  legacySourceUrl String? // 이전 사이트에서 이관한 글의 원본 상세 URL(내부 추적용)
  authorId        String // 작성자(User) FK
  createdAt       DateTime     @default(now()) // 생성 시각
  updatedAt       DateTime     @updatedAt // 수정 시각

  author     User        @relation(fields: [authorId], references: [id]) // 작성자(User) 관계
  fileUsages PostAsset[] // 게시글에서 사용하는 파일과 역할 목록

  @@index([category, isPublished, publishedAt])
  @@index([category, isPublished, sortOrder, createdAt])
  @@index([legacySourceUrl])
  @@index([createdAt])
}

model FileAsset {
  id           String   @id @default(cuid()) // 물리 파일 자산 고유 식별자
  bucket       String // MinIO 버킷
  objectKey    String // 버킷 내부 객체 키
  url          String   @unique // 현재 공개 URL이며 파일 식별에는 사용하지 않음
  originalName String // 업로드 원본 파일명
  mimeType     String // 저장 객체 MIME 타입
  sizeBytes    Int // 저장 객체 크기(byte)
  uploadedById String // 업로드한 관리자 식별자
  createdAt    DateTime @default(now()) // 업로드 시각 및 미사용 파일 유예 시간 기준
  updatedAt    DateTime @updatedAt // 메타데이터 변경 시각

  uploadedBy User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  postUsages PostAsset[] // 게시글 사용처 목록, 비어 있으면 PENDING 자산으로 간주

  @@unique([bucket, objectKey])
  @@index([uploadedById, createdAt])
  @@index([createdAt])
}

model PostAsset {
  id        String        @id @default(cuid()) // 게시글 파일 사용처 고유 식별자
  postId    String // 파일을 사용하는 게시글
  assetId   String // 물리 파일 자산
  role      PostAssetRole // 본문·대표·첨부 역할
  sortOrder Int           @default(0) // 같은 역할 내 노출 순서
  createdAt DateTime      @default(now()) // 게시글 연결 시각

  post  Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset FileAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([postId, assetId, role])
  @@index([postId, role, sortOrder])
  @@index([assetId])
}

model Event {
  id          String   @id @default(cuid()) // 고유 식별자
  title       String // 제목
  description String?  @db.Text // 설명/본문(선택)
  startsAt    DateTime // 일정 시작 일시
  endsAt      DateTime // 일정 종료 일시
  isPublished Boolean  @default(true) // 공개 여부
  createdById String // 작성자(User) FK
  createdAt   DateTime @default(now()) // 생성 시각
  updatedAt   DateTime @updatedAt // 수정 시각

  createdBy User @relation(fields: [createdById], references: [id]) // 작성자(User) 관계

  @@index([startsAt, endsAt])
  @@index([isPublished])
}

model MassSchedule {
  id          String   @id @default(cuid()) // 고유 식별자
  title       String // 제목
  description String?  @db.Text // 설명/본문(선택)
  sortOrder   Int      @default(0) // 노출 정렬 순서
  isActive    Boolean  @default(true) // 활성/비활성 상태
  createdAt   DateTime @default(now()) // 생성 시각
  updatedAt   DateTime @updatedAt // 수정 시각

  @@index([isActive, sortOrder])
}

model ClergyProfile {
  id            String     @id @default(cuid()) // 고유 식별자
  type          ClergyType // 성직자 구분(신부/수녀)
  name          String // 이름
  baptismalName String? // 세례명
  duty          String // 담당 직무/영역
  feastMonth    Int? // 축일 월(선택)
  feastDay      Int? // 축일 일(선택)
  termStart     DateTime? // 재임 시작일(선택)
  termEnd       DateTime? // 재임 종료일(선택)
  phone         String? // 연락처(선택)
  imageUrl      String? // 프로필 이미지 URL(선택)
  isCurrent     Boolean    @default(true) // 현직 여부
  sortOrder     Int        @default(0) // 노출 정렬 순서
  createdAt     DateTime   @default(now()) // 생성 시각
  updatedAt     DateTime   @updatedAt // 수정 시각

  @@index([type, isCurrent, sortOrder])
}

model PastoralCouncilPosition {
  id                          String                              @id @default(cuid()) // 직책 고유 식별자
  title                       String // 관리자에게 노출되는 직책명
  parentId                    String? // 상위 직책 식별자, 최상위 직책이면 null
  sortOrder                   Int                                 @default(0) // 같은 상위 직책 아래의 노출 순서
  isActive                    Boolean                             @default(true) // 공개 조직도 노출 여부
  defaultPlaceholderImageType PastoralCouncilPlaceholderImageType @default(MAN) // 공석 카드의 기본 이미지 유형
  createdAt                   DateTime                            @default(now()) // 생성 시각
  updatedAt                   DateTime                            @updatedAt // 수정 시각

  parent   PastoralCouncilPosition?  @relation("PastoralCouncilPositionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children PastoralCouncilPosition[] @relation("PastoralCouncilPositionTree")
  members  PastoralCouncilMember[]

  @@index([parentId, isActive, sortOrder])
}

model PastoralCouncilMember {
  id                   String                              @id @default(cuid()) // 고유 식별자
  positionId           String // 배정된 직책 식별자
  name                 String // 이름
  baptismalName        String? // 세례명(선택)
  phone                String? // 연락처(선택)
  imageUrl             String? // 프로필 이미지 URL(선택)
  placeholderImageType PastoralCouncilPlaceholderImageType @default(PRIEST) // 이미지 없을 때 사용할 대체 이미지 유형
  sortOrder            Int                                 @default(0) // 노출 정렬 순서
  isActive             Boolean                             @default(true) // 공개 활성 상태
  createdAt            DateTime                            @default(now()) // 생성 시각
  updatedAt            DateTime                            @updatedAt // 수정 시각

  position PastoralCouncilPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([positionId, isActive, sortOrder])
}

model Inquiry {
  id             String        @id @default(cuid()) // 고유 식별자
  title          String? // 제목(선택)
  email          String? // 관리자 이메일(선택, 중복 불가)
  phone          String? // 연락처(선택)
  content        String        @db.Text // 본문 내용
  inquiryType    InquiryType   @default(OTHER) // 문의 유형 enum(카테고리 분류)
  status         InquiryStatus @default(RECEIVED) // 처리 상태 enum(접수/처리중/완료)
  isPrivate      Boolean       @default(true) // 비공개 문의 여부
  processingMemo String?       @db.Text // 내부 처리 메모(1개)
  processedAt    DateTime? // 메모 처리/완료 시각
  processedById  String? // 메모 처리자(User) FK
  createdAt      DateTime      @default(now()) // 생성 시각
  updatedAt      DateTime      @updatedAt // 수정 시각

  processedBy User? @relation("InquiryProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([processedById])
}
